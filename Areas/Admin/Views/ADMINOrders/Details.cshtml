@model Interview1.Models.Entities.Order

@{
    ViewData["Title"] = "訂單查詢";
}

<h2>訂單明細</h2>

<table border="1" cellpadding="8">
    <tr>
        <th>訂單編號</th>
        <td>@Model.OrderId</td>
    </tr>

    <tr>
        <th>訂單日期</th>
        <td>@Model.OrderDate</td>
    </tr>

    <tr>
        <th>會員編號</th>
        <td>@Model.MemberId</td>
    </tr>

    <tr>
        <th>訂單總金額</th>
        <td>@Model.TotalAmount</td>
    </tr>

    <tr>
        <th>訂單狀態</th>
        <td>@Model.OrderStatus</td>
    </tr>

    <tr>
        <th>付款方式</th>
        <td>@Model.PaymentMethod</td>
    </tr>

    <tr>
        <th>出貨狀態</th>
        <td>@Model.ShippingStatus</td>
    </tr>

    <tr>
        <th>備註</th>
        <td>@Model.Note</td>
    </tr>
</table>

<button><a asp-area="Admin" asp-controller="ADMINOrders" asp-action="Index">返回訂單總覽</a></button>